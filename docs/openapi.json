                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Mona Lisa"
                    },
                    "ano": {
                        "type": "string",
                        "example": "1503–1519"
                    },
                    "tecnica": {
                        "type": "string",
                        "example": "Óleo sobre madeira"
                    },
                    "localizacao": {
                        "type": "string",
                        "example": "Museu do Louvre, Paris"
                    },
                    "imagem": {
                        "type": "string",
                        "example": "https://exemplo.com/monalisa.jpg"
                    },
                    "descricao": {
