    "components": {
        "schemas": {
            "Usuarios": {
                "properties": {
                    "id_usuario": {
                        "type": "integer"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "senha": {
                        "type": "string",
                        "format": "password"
                    },
                    "data_cadastro": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "UsuarioInput": {
                "required": [
                    "nome",
                    "email",
                    "senha"
                ],
                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Leonardo da Silva"
                    },
                    "email": {
                        "type": "string",
                        "example": "leonardo@email.com"
                    },
                    "senha": {
                        "type": "string",
                        "minLength": 6,
                        "example": "senha123"
                    }
                },
                "type": "object"
            },
            "UsuarioUpdateInput": {
                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Leonardo da Silva"
                    },
                    "email": {
                        "type": "string",
                        "example": "leonardo@email.com"
                    }
                },
                "type": "object"
            },
